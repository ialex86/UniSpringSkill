{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "python3 {{SKILL_DIR}}/scripts/hooks/agent_hook.py cursor start", "timeout": 120}
    ],
    "afterFileEdit": [
      {"command": "python3 {{SKILL_DIR}}/scripts/hooks/agent_hook.py cursor edit", "timeout": 60}
    ],
    "stop": [
      {"command": "python3 {{SKILL_DIR}}/scripts/hooks/agent_hook.py cursor stop", "timeout": 180, "loop_limit": 2}
    ]
  }
}
